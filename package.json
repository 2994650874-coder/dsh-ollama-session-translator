{
  "name": "dsh-cot-en2cn",
  "version": "0.1.0",
  "description": "Inline English-to-Chinese translation plugin for DeepSeek Harness (DSH) thinking blocks. Zero dependency on DSH internals, no slot, no renderer override, no session-log writes.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "locale"
  ],
  "license": "MIT",
  "author": "Eyeing0721",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2994650874-coder/dsh-ollama-session-translator.git"
  },
  "homepage": "https://github.com/2994650874-coder/dsh-ollama-session-translator#readme",
  "bugs": {
    "url": "https://github.com/2994650874-coder/dsh-ollama-session-translator/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "chain-of-thought",
    "cot",
    "reasoning",
    "thinking",
    "translation",
    "chinese",
    "client-plugin",
    "web-ui",
    "non-invasive",
    "zero-dependency"
  ],
  "dependencies": {},
  "scripts": {
    "test": "node tools/smoke.mjs && node tools/live-lock-check.mjs && node tools/err-i18n-test.mjs && node tools/select-safe-test.mjs && node tools/host-integration.mjs && node tools/parity-check.mjs && node tools/browser-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-session-translator",
    "summary": "展开英文思考块即可在下方阅读中文译文。零依赖 DSH 内部 API、不占 slot 不碰渲染树、不写会话日志——DSH 升级不影响它，卸载无残留。",
    "categories": [
      "Web UI",
      "翻译",
      "效率"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    },
    "permissions": {}
  }
}
